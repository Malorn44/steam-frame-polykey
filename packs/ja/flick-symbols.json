{
  "$schema": "../../schema/pack.schema.json",
  "schemaVersion": 1,
  "kind": "layout",
  "id": "ja/flick-symbols",
  "name": "Japanese 12-key numbers and symbols",
  "description": "The 12-key's ?123 page: digits and symbols, typed in the mode it was opened from (kana: into the reading; ABC: into the English word). あいう goes back; =\\< shows more symbols.",
  "large": true,
  "toolbar": [
    {
      "type": "action",
      "action": "settings"
    },
    {
      "type": "action",
      "action": "emoji"
    },
    {
      "type": "action",
      "action": "dictate"
    },
    {
      "type": "action",
      "action": "copy"
    },
    {
      "type": "action",
      "action": "cut"
    },
    {
      "type": "action",
      "action": "paste"
    },
    {
      "type": "action",
      "action": "menu"
    },
    {
      "type": "action",
      "action": "hide"
    }
  ],
  "rows": [
    [{"type": "char", "char": "1"}, {"type": "char", "char": "2"}, {"type": "char", "char": "3"}, {"type": "char", "char": "4"}, {"type": "char", "char": "5"}, {"type": "char", "char": "6"}, {"type": "char", "char": "7"}, {"type": "char", "char": "8"}, {"type": "char", "char": "9"}, {"type": "char", "char": "0"}],
    [{"type": "char", "char": "@"}, {"type": "char", "char": "#"}, {"type": "char", "char": "¥"}, {"type": "char", "char": "÷"}, {"type": "char", "char": "&"}, {"type": "char", "char": "-"}, {"type": "char", "char": "+"}, {"type": "char", "char": "("}, {"type": "char", "char": ")"}, {"type": "char", "char": "/"}],
    [{"type": "action", "action": "more-symbols", "w": 1.5}, {"type": "char", "char": "*"}, {"type": "char", "char": "\""}, {"type": "char", "char": "'"}, {"type": "char", "char": ":"}, {"type": "char", "char": ";"}, {"type": "char", "char": "!"}, {"type": "char", "char": "?"}, {"type": "key", "key": "Backspace", "w": 1.5}],
    [{"type": "action", "action": "next-keyboard"}, {"type": "action", "action": "symbols", "label": "あいう", "w": 1.5}, {"type": "char", "char": ","}, {"type": "char", "char": " ", "w": 3.5}, {"type": "char", "char": "."}, {"type": "key", "key": "Enter", "w": 2}]
  ]
}
