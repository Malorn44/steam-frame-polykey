{
  "$schema": "../pack.schema.json",
  "schemaVersion": 1,
  "kind": "layout",
  "id": "ja/flick-symbols",
  "name": "Japanese 12-key numbers and symbols",
  "description": "The 12-key's ?123 page: digits and symbols, typed in the mode it was opened from (kana: into the reading; ABC: into the English word). The back key returns to the letters (あいう from kana, ABC from 英数); =\\< shows more symbols.",
  "large": true,
  "rows": [
    [{"char": "1"}, {"char": "2"}, {"char": "3"}, {"char": "4"}, {"char": "5"}, {"char": "6"}, {"char": "7"}, {"char": "8"}, {"char": "9"}, {"char": "0"}],
    [{"char": "@"}, {"char": "#"}, {"char": "¥"}, {"char": "÷"}, {"char": "&"}, {"char": "-"}, {"char": "+"}, {"char": "("}, {"char": ")"}, {"char": "/"}],
    [{"action": "more-symbols", "w": 1.5}, {"char": "*"}, {"char": "\""}, {"char": "'"}, {"char": ":"}, {"char": ";"}, {"char": "!"}, {"char": "?"}, {"key": "Backspace", "w": 1.5}],
    [{"action": "next-keyboard"}, {"action": "symbols", "w": 1.5}, {"char": ","}, {"char": " ", "w": 3.5, "alone": {"w": 4.5}}, {"char": "."}, {"key": "Enter", "w": 2}]
  ]
}
