{
  "$schema": "../pack.schema.json",
  "schemaVersion": 1,
  "kind": "layout",
  "id": "ja/kana-jis",
  "name": "Japanese kana (JIS)",
  "description": "The JIS keyboard, Mac style: 英数 types each key's Latin legends, かな its kana (Shift: the upper legend). かな while typing changes the reading to カタカナ, then ﾊﾝｶｸ. ゛ and ゜ join the kana before them.",
  "large": true,
  "dotted": "\"'=-~^`ー「」。・_.,、゛゜",
  "rows": [
    [{"key": "Escape"}, {"char": "1", "shift": "!", "kana": "ぬ", "fn": {"key": "F1"}}, {"char": "2", "shift": "\"", "kana": "ふ", "fn": {"key": "F2"}}, {"char": "3", "shift": "#", "kana": "あ", "kanaShift": "ぁ", "fn": {"key": "F3"}}, {"char": "4", "shift": "$", "kana": "う", "kanaShift": "ぅ", "fn": {"key": "F4"}}, {"char": "5", "shift": "%", "kana": "え", "kanaShift": "ぇ", "fn": {"key": "F5"}}, {"char": "6", "shift": "&", "kana": "お", "kanaShift": "ぉ", "fn": {"key": "F6"}}, {"char": "7", "shift": "'", "kana": "や", "kanaShift": "ゃ", "fn": {"key": "F7"}}, {"char": "8", "shift": "(", "kana": "ゆ", "kanaShift": "ゅ", "fn": {"key": "F8"}}, {"char": "9", "shift": ")", "kana": "よ", "kanaShift": "ょ", "fn": {"key": "F9"}}, {"char": "0", "kana": "わ", "kanaShift": "を", "fn": {"key": "F10"}}, {"char": "-", "shift": "=", "kana": "ほ", "fn": {"key": "F11"}}, {"char": "^", "shift": "~", "kana": "へ", "fn": {"key": "F12"}}, {"char": "¥", "shift": "|", "kana": "ー"}, {"key": "Backspace", "w": 1}],
    [{"key": "Tab", "w": 1.5}, {"char": "q", "kana": "た"}, {"char": "w", "kana": "て"}, {"char": "e", "kana": "い", "kanaShift": "ぃ"}, {"char": "r", "kana": "す"}, {"char": "t", "kana": "か"}, {"char": "y", "kana": "ん"}, {"char": "u", "kana": "な"}, {"char": "i", "kana": "に"}, {"char": "o", "kana": "ら"}, {"char": "p", "kana": "せ"}, {"char": "@", "shift": "`", "kana": "゛"}, {"char": "[", "shift": "{", "kana": "゜", "kanaShift": "「"}, {"key": "Enter", "w": 1.5, "rows": 2, "notch": 0.25}],
    [{"mod": "caps", "w": 1.75}, {"char": "a", "kana": "ち"}, {"char": "s", "kana": "と"}, {"char": "d", "kana": "し"}, {"char": "f", "kana": "は"}, {"char": "g", "kana": "き"}, {"char": "h", "kana": "く"}, {"char": "j", "kana": "ま"}, {"char": "k", "kana": "の"}, {"char": "l", "kana": "り"}, {"char": ";", "shift": "+", "kana": "れ"}, {"char": ":", "shift": "*", "kana": "け"}, {"char": "]", "shift": "}", "kana": "む", "kanaShift": "」"}],
    [{"mod": "shift", "w": 2.25}, {"char": "z", "kana": "つ", "kanaShift": "っ"}, {"char": "x", "kana": "さ"}, {"char": "c", "kana": "そ"}, {"char": "v", "kana": "ひ"}, {"char": "b", "kana": "こ"}, {"char": "n", "kana": "み"}, {"char": "m", "kana": "も"}, {"char": ",", "shift": "<", "kana": "ね", "kanaShift": "、"}, {"char": ".", "shift": ">", "kana": "る", "kanaShift": "。"}, {"char": "/", "shift": "?", "kana": "め", "kanaShift": "・"}, {"char": "\\", "shift": "_", "kana": "ろ"}, {"mod": "shift", "w": 1.75}],
    [{"mod": "fn", "w": 1}, {"mod": "ctrl", "w": 1}, {"mod": "super", "w": 1}, {"mod": "alt", "w": 1}, {"action": "eisu", "w": 1.25}, {"char": " ", "w": 4, "alone": {"w": 5}}, {"action": "kana", "w": 1.25}, {"key": "ArrowLeft", "w": 0.875}, {"key": "ArrowUp", "w": 0.875}, {"key": "ArrowDown", "w": 0.875}, {"key": "ArrowRight", "w": 0.875}, {"action": "next-keyboard", "w": 1}]
  ]
}
