{
  "$schema": "../pack.schema.json",
  "schemaVersion": 1,
  "kind": "layout",
  "id": "ja/flick-abc",
  "name": "Japanese 12-key letters (ABC)",
  "description": "The phone 12-key's letters mode: tap a key for its first letter, flick left, up or right for the next, down for its digit. a⇔A is Shift (twice: caps lock). あa goes back to kana.",
  "large": true,
  "rows": [
    [{"type": "action", "action": "undo"}, {"type": "char", "char": "@", "flick": {"left": "-", "up": "_", "right": "/", "down": "1"}, "label": "@-_/", "sub": "1"}, {"type": "char", "char": "a", "flick": {"left": "b", "up": "c", "down": "2"}, "label": "abc", "sub": "2"}, {"type": "char", "char": "d", "flick": {"left": "e", "up": "f", "down": "3"}, "label": "def", "sub": "3"}, {"type": "key", "key": "Backspace"}],
    [{"type": "key", "key": "ArrowLeft"}, {"type": "char", "char": "g", "flick": {"left": "h", "up": "i", "down": "4"}, "label": "ghi", "sub": "4"}, {"type": "char", "char": "j", "flick": {"left": "k", "up": "l", "down": "5"}, "label": "jkl", "sub": "5"}, {"type": "char", "char": "m", "flick": {"left": "n", "up": "o", "down": "6"}, "label": "mno", "sub": "6"}, {"type": "key", "key": "ArrowRight"}],
    [{"type": "action", "action": "kana", "legends": {"c": {"parts": ["あ", "a"]}}}, {"type": "char", "char": "p", "flick": {"left": "q", "up": "r", "right": "s", "down": "7"}, "label": "pqrs", "sub": "7"}, {"type": "char", "char": "t", "flick": {"left": "u", "up": "v", "down": "8"}, "label": "tuv", "sub": "8"}, {"type": "char", "char": "w", "flick": {"left": "x", "up": "y", "right": "z", "down": "9"}, "label": "wxyz", "sub": "9"}, {"type": "char", "char": " "}],
    [{"type": "action", "action": "next-keyboard", "w": 0.5}, {"type": "action", "action": "symbols", "w": 0.5, "alone": {"w": 1}}, {"type": "mod", "mod": "shift", "label": "a⇔A"}, {"type": "char", "char": "'", "flick": {"left": "\"", "up": ":", "right": ";", "down": "0"}, "label": "'\":;", "sub": "0"}, {"type": "char", "char": ".", "flick": {"left": ",", "up": "?", "right": "!"}, "label": ".,?!"}, {"type": "key", "key": "Enter"}]
  ]
}
