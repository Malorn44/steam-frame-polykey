{
  "$schema": "../pack.schema.json",
  "schemaVersion": 1,
  "kind": "layout",
  "id": "ja/flick-abc",
  "name": "Japanese 12-key letters (ABC)",
  "description": "The phone 12-key's letters mode: tap a key for its first letter, flick left, up or right for the next, down for its digit. a⇔A is Shift (twice: caps lock). あa goes back to kana.",
  "large": true,
  "rows": [
    [{"action": "undo"}, {"char": "@", "flick": {"left": "-", "up": "_", "right": "/", "down": "1"}, "label": "@-_/", "legends": {"c": {"under": "1"}}}, {"char": "a", "flick": {"left": "b", "up": "c", "down": "2"}, "label": "abc", "legends": {"c": {"under": "2"}}}, {"char": "d", "flick": {"left": "e", "up": "f", "down": "3"}, "label": "def", "legends": {"c": {"under": "3"}}}, {"key": "Backspace"}],
    [{"key": "ArrowLeft"}, {"char": "g", "flick": {"left": "h", "up": "i", "down": "4"}, "label": "ghi", "legends": {"c": {"under": "4"}}}, {"char": "j", "flick": {"left": "k", "up": "l", "down": "5"}, "label": "jkl", "legends": {"c": {"under": "5"}}}, {"char": "m", "flick": {"left": "n", "up": "o", "down": "6"}, "label": "mno", "legends": {"c": {"under": "6"}}}, {"key": "ArrowRight"}],
    [{"action": "kana", "legends": {"c": {"parts": ["あ", "a"]}}}, {"char": "p", "flick": {"left": "q", "up": "r", "right": "s", "down": "7"}, "label": "pqrs", "legends": {"c": {"under": "7"}}}, {"char": "t", "flick": {"left": "u", "up": "v", "down": "8"}, "label": "tuv", "legends": {"c": {"under": "8"}}}, {"char": "w", "flick": {"left": "x", "up": "y", "right": "z", "down": "9"}, "label": "wxyz", "legends": {"c": {"under": "9"}}}, {"char": " "}],
    [{"action": "next-keyboard", "w": 0.5}, {"action": "symbols", "w": 0.5, "alone": {"w": 1}}, {"mod": "shift", "label": "a⇔A"}, {"char": "'", "flick": {"left": "\"", "up": ":", "right": ";", "down": "0"}, "label": "'\":;", "legends": {"c": {"under": "0"}}}, {"char": ".", "flick": {"left": ",", "up": "?", "right": "!"}, "label": ".,?!"}, {"key": "Enter"}]
  ]
}
