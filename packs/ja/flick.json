{
  "$schema": "../pack.schema.json",
  "schemaVersion": 1,
  "kind": "layout",
  "id": "ja/flick",
  "name": "Japanese 12-key (flick)",
  "description": "The phone 12-key: tap a key for its あ-row kana, flick left, up, right or down for the rest. Same arrangement as frame-jp-keyboard (MIT) and phones.",
  "large": true,
  "rows": [
    [{"action": "undo"}, {"char": "あ", "flick": {"left": "い", "up": "う", "right": "え", "down": "お"}, "cycle": ["あ", "い", "う", "え", "お", "ぁ", "ぃ", "ぅ", "ぇ", "ぉ"]}, {"char": "か", "flick": {"left": "き", "up": "く", "right": "け", "down": "こ"}}, {"char": "さ", "flick": {"left": "し", "up": "す", "right": "せ", "down": "そ"}}, {"key": "Backspace"}],
    [{"key": "ArrowLeft"}, {"char": "た", "flick": {"left": "ち", "up": "つ", "right": "て", "down": "と"}, "cycle": ["た", "ち", "つ", "て", "と", "っ"]}, {"char": "な", "flick": {"left": "に", "up": "ぬ", "right": "ね", "down": "の"}}, {"char": "は", "flick": {"left": "ひ", "up": "ふ", "right": "へ", "down": "ほ"}}, {"key": "ArrowRight"}],
    [{"action": "eisu", "legends": {"c": {"parts": ["あ", "a"]}}}, {"char": "ま", "flick": {"left": "み", "up": "む", "right": "め", "down": "も"}}, {"char": "や", "flick": {"left": "「", "up": "ゆ", "right": "」", "down": "よ"}, "cycle": ["や", "ゆ", "よ", "ゃ", "ゅ", "ょ"]}, {"char": "ら", "flick": {"left": "り", "up": "る", "right": "れ", "down": "ろ"}}, {"char": " "}],
    [{"action": "next-keyboard", "w": 0.5}, {"action": "symbols", "w": 0.5, "alone": {"w": 1}}, {"action": "modify", "legends": {"c": {"marks": ["゛", "゜"], "under": "大⇔小"}}}, {"char": "わ", "flick": {"left": "を", "up": "ん", "right": "ー", "down": "～"}, "cycle": ["わ", "を", "ん", "ゎ", "ー", "～"]}, {"char": "、", "flick": {"left": "。", "up": "？", "right": "！", "down": "…"}, "flickHints": true}, {"key": "Enter"}]
  ],
  "modify": "ja/modify",
  "dotted": "゛゜、。"
}
