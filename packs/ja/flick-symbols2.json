{
  "$schema": "../pack.schema.json",
  "schemaVersion": 1,
  "kind": "layout",
  "id": "ja/flick-symbols2",
  "name": "Japanese 12-key more symbols",
  "description": "The 12-key's second symbols page (=\\<): typed in the mode it was opened from. 123 goes back to the numbers, the back key to the letters (あいう or ABC).",
  "large": true,
  "rows": [
    [{"char": "~"}, {"char": "`"}, {"char": "|"}, {"char": "·"}, {"char": "√"}, {"char": "π"}, {"char": "÷"}, {"char": "×"}, {"char": "§"}, {"char": "Δ"}],
    [{"char": "£"}, {"char": "€"}, {"char": "$"}, {"char": "¢"}, {"char": "^"}, {"char": "°"}, {"char": "="}, {"char": "{"}, {"char": "}"}, {"char": "\\"}],
    [{"action": "more-symbols", "w": 1.5}, {"char": "_"}, {"char": "©"}, {"char": "®"}, {"char": "™"}, {"char": "✓"}, {"char": "["}, {"char": "]"}, {"key": "Backspace", "w": 1.5}],
    [{"action": "next-keyboard"}, {"action": "symbols", "w": 1.5}, {"char": "<"}, {"char": " ", "w": 3.5, "alone": {"w": 4.5}}, {"char": ">"}, {"key": "Enter", "w": 2}]
  ]
}
