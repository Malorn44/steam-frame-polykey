{
  "$schema": "../pack.schema.json",
  "schemaVersion": 1,
  "kind": "layout",
  "id": "ja/qwerty-romaji",
  "name": "Japanese romaji (QWERTY)",
  "description": "The English QWERTY layout with the Mac's 英数 and かな beside Space: かな types romaji into the reading buffer, 英数 types Latin directly.",
  "extends": "en/qwerty",
  "rows": {
    "4": [{"mod": "fn"}, {"mod": "ctrl"}, {"mod": "super"}, {"mod": "alt"}, {"action": "eisu", "w": 1.5}, {"char": " ", "w": 4.25}, {"action": "kana", "w": 1.5}, {"key": "ArrowLeft", "alone": {"w": 1.25}}, {"key": "ArrowDown", "alone": {"w": 1.25}}, {"key": "ArrowRight", "alone": {"w": 1.25}}, {"action": "next-keyboard", "w": 0.75}]
  }
}
