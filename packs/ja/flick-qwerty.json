{
  "$schema": "../../schema/pack.schema.json",
  "schemaVersion": 1,
  "kind": "layout",
  "id": "ja/flick-qwerty",
  "name": "Japanese 12-key letters (QWERTY)",
  "description": "The 12-key's ABC mode as a QWERTY keyboard (the ABC keys option): hold a top-row letter for its digit. あ a goes back to kana; ?123 opens the symbols pages.",
  "large": true,
  "rows": [
    [{"type": "char", "char": "q", "long": ["1"], "hint": "1"}, {"type": "char", "char": "w", "long": ["2"], "hint": "2"}, {"type": "char", "char": "e", "long": ["3", "è", "é", "ê", "ë", "ē", "ė", "ę"], "hint": "3"}, {"type": "char", "char": "r", "long": ["4"], "hint": "4"}, {"type": "char", "char": "t", "long": ["5"], "hint": "5"}, {"type": "char", "char": "y", "long": ["6", "ÿ", "ý"], "hint": "6"}, {"type": "char", "char": "u", "long": ["7", "û", "ü", "ù", "ú", "ū"], "hint": "7"}, {"type": "char", "char": "i", "long": ["8", "î", "ï", "í", "ī", "į", "ì"], "hint": "8"}, {"type": "char", "char": "o", "long": ["9", "ô", "ö", "ò", "ó", "œ", "ø", "ō", "õ"], "hint": "9"}, {"type": "char", "char": "p", "long": ["0"], "hint": "0"}],
    [{"type": "mod", "mod": "caps"}, {"type": "char", "char": "a", "long": ["à", "á", "â", "ä", "æ", "ã", "å", "ā"]}, {"type": "char", "char": "s", "long": ["ß", "ś", "š"]}, {"type": "char", "char": "d"}, {"type": "char", "char": "f"}, {"type": "char", "char": "g"}, {"type": "char", "char": "h"}, {"type": "char", "char": "j"}, {"type": "char", "char": "k"}, {"type": "char", "char": "l", "long": ["ł"]}],
    [{"type": "mod", "mod": "shift", "w": 1.5}, {"type": "char", "char": "z", "long": ["ž", "ź", "ż"]}, {"type": "char", "char": "x"}, {"type": "char", "char": "c", "long": ["ç", "ć", "č"]}, {"type": "char", "char": "v"}, {"type": "char", "char": "b"}, {"type": "char", "char": "n", "long": ["ñ", "ń"]}, {"type": "char", "char": "m"}, {"type": "key", "key": "Backspace", "w": 1.5}],
    [{"type": "action", "action": "next-keyboard"}, {"type": "action", "action": "kana", "legends": {"c": {"parts": ["あ", "a"]}}, "w": 1.25}, {"type": "action", "action": "symbols", "w": 1.25}, {"type": "char", "char": ",", "w": 0.75}, {"type": "char", "char": " ", "w": 2.5}, {"type": "char", "char": ".", "w": 0.75}, {"type": "key", "key": "ArrowLeft", "w": 0.75}, {"type": "key", "key": "ArrowRight", "w": 0.75}, {"type": "key", "key": "Enter"}]
  ]
}
