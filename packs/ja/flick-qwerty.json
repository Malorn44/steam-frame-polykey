{
  "$schema": "../pack.schema.json",
  "schemaVersion": 1,
  "kind": "layout",
  "id": "ja/flick-qwerty",
  "name": "Japanese 12-key letters (QWERTY)",
  "description": "The 12-key's ABC mode as a QWERTY keyboard (the ABC keys option): hold a top-row letter for its digit. あa goes back to kana; ?123 opens the symbols pages.",
  "large": true,
  "rows": [
    [{"char": "q", "long": ["1"], "hint": "1"}, {"char": "w", "long": ["2"], "hint": "2"}, {"char": "e", "long": ["3", "è", "é", "ê", "ë", "ē", "ė", "ę"], "hint": "3"}, {"char": "r", "long": ["4"], "hint": "4"}, {"char": "t", "long": ["5"], "hint": "5"}, {"char": "y", "long": ["6", "ÿ", "ý"], "hint": "6"}, {"char": "u", "long": ["7", "û", "ü", "ù", "ú", "ū"], "hint": "7"}, {"char": "i", "long": ["8", "î", "ï", "í", "ī", "į", "ì"], "hint": "8"}, {"char": "o", "long": ["9", "ô", "ö", "ò", "ó", "œ", "ø", "ō", "õ"], "hint": "9"}, {"char": "p", "long": ["0"], "hint": "0"}],
    [{"mod": "caps"}, {"char": "a", "long": ["à", "á", "â", "ä", "æ", "ã", "å", "ā"]}, {"char": "s", "long": ["ß", "ś", "š"]}, {"char": "d"}, {"char": "f"}, {"char": "g"}, {"char": "h"}, {"char": "j"}, {"char": "k"}, {"char": "l", "long": ["ł"]}],
    [{"mod": "shift", "w": 1.5}, {"char": "z", "long": ["ž", "ź", "ż"]}, {"char": "x"}, {"char": "c", "long": ["ç", "ć", "č"]}, {"char": "v"}, {"char": "b"}, {"char": "n", "long": ["ñ", "ń"]}, {"char": "m"}, {"key": "Backspace", "w": 1.5}],
    [{"action": "next-keyboard"}, {"action": "kana", "legends": {"c": {"parts": ["あ", "a"]}}, "w": 1.25}, {"action": "symbols", "w": 1.25}, {"char": ",", "w": 0.75}, {"char": " ", "w": 2.5, "alone": {"w": 3.5}}, {"char": ".", "w": 0.75}, {"key": "ArrowLeft", "w": 0.75}, {"key": "ArrowRight", "w": 0.75}, {"key": "Enter"}]
  ]
}
