{
  "$schema": "../pack.schema.json",
  "schemaVersion": 1,
  "kind": "layout",
  "id": "ja/gojuon",
  "name": "Japanese 五十音",
  "description": "The 50-sound table as keys, read right to left (あ か さ … わ), as Gboard's 五十音 layout: tap a kana, ゛゜小 changes the one before. あa switches to letters, ?123 to the symbols pages.",
  "large": true,
  "modify": "ja/modify",
  "dotted": "゛゜、。",
  "rows": [
    [{"action": "undo", "w": 1.5}, {"char": "、"}, {"char": "わ"}, {"char": "ら"}, {"char": "や"}, {"char": "ま"}, {"char": "は"}, {"char": "な"}, {"char": "た"}, {"char": "さ"}, {"char": "か"}, {"char": "あ"}, {"key": "Backspace", "w": 1.5}],
    [{"action": "symbols", "w": 1.5}, {"char": "。"}, {"char": "を"}, {"char": "り"}, {"w": 1}, {"char": "み"}, {"char": "ひ"}, {"char": "に"}, {"char": "ち"}, {"char": "し"}, {"char": "き"}, {"char": "い"}, {"key": "ArrowLeft", "w": 0.75}, {"key": "ArrowRight", "w": 0.75}],
    [{"action": "eisu", "legends": {"c": {"parts": ["あ", "a"]}}, "w": 1.5, "rows": 2, "alone": {"rows": 3}}, {"char": "？"}, {"char": "ん"}, {"char": "る"}, {"char": "ゆ"}, {"char": "む"}, {"char": "ふ"}, {"char": "ぬ"}, {"char": "つ"}, {"char": "す"}, {"char": "く"}, {"char": "う"}, {"char": " ", "w": 1.5}],
    [{"char": "！"}, {"char": "ー"}, {"char": "れ"}, {"w": 1}, {"char": "め"}, {"char": "へ"}, {"char": "ね"}, {"char": "て"}, {"char": "せ"}, {"char": "け"}, {"char": "え"}, {"key": "Enter", "w": 1.5, "rows": 2}],
    [{"action": "next-keyboard", "w": 1.5}, {"char": "「", "long": ["」"], "label": "「」"}, {"action": "modify", "legends": {"c": {"marks": ["゛", "゜"], "under": "大⇔小"}}}, {"char": "ろ"}, {"char": "よ"}, {"char": "も"}, {"char": "ほ"}, {"char": "の"}, {"char": "と"}, {"char": "そ"}, {"char": "こ"}, {"char": "お"}]
  ]
}
