    [{"type": "action", "action": "symbols", "w": 1.5}, {"type": "char", "char": "。"}, {"type": "char", "char": "を"}, {"type": "char", "char": "り"}, {"type": "gap", "w": 1}, {"type": "char", "char": "み"}, {"type": "char", "char": "ひ"}, {"type": "char", "char": "に"}, {"type": "char", "char": "ち"}, {"type": "char", "char": "し"}, {"type": "char", "char": "き"}, {"type": "char", "char": "い"}, {"type": "key", "key": "ArrowLeft", "w": 0.75}, {"type": "key", "key": "ArrowRight", "w": 0.75}],
    [{"type": "action", "action": "eisu", "label": "あ a", "w": 1.5, "tall": "top"}, {"type": "char", "char": "？"}, {"type": "char", "char": "ん"}, {"type": "char", "char": "る"}, {"type": "char", "char": "ゆ"}, {"type": "char", "char": "む"}, {"type": "char", "char": "ふ"}, {"type": "char", "char": "ぬ"}, {"type": "char", "char": "つ"}, {"type": "char", "char": "す"}, {"type": "char", "char": "く"}, {"type": "char", "char": "う"}, {"type": "char", "char": " ", "w": 1.5}],
