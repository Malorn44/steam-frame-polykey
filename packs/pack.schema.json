{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polykey/packs/pack.schema.json",
  "title": "polykey pack item",
  "description": "One layout, keyboard, theme, table or picker set. Files live in packs/<namespace>/; ids are <namespace>/<name>.",
  "oneOf": [
    {
      "$ref": "#/$defs/layout"
    },
    {
      "$ref": "#/$defs/keyboard"
    },
    {
      "$ref": "#/$defs/theme"
    },
    {
      "$ref": "#/$defs/table"
    },
    {
      "$ref": "#/$defs/picker"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "maxLength": 80
    },
    "name": {
      "description": "A name: one string, or a name per language code, e.g. {\"en\": \"Smiling\", \"ja\": \"笑顔\"}.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      ]
    },
    "icon": {
      "enum": [
        "settings",
        "emoji",
        "dictate",
        "copy",
        "cut",
        "paste",
        "hide",
        "close",
        "back",
        "menu",
        "recent",
        "favorites",
        "smileys",
        "people",
        "animals",
        "food",
        "travel",
        "activities",
        "objects",
        "symbols",
        "flags",
        "clear",
        "emoticons",
        "stickers",
        "effects",
        "backspace",
        "undo",
        "backspaceTag",
        "enter",
        "left",
        "space",
        "right",
        "up",
        "down",
        "chevron",
        "globe",
        "shift",
        "shiftLocked",
        "caps",
        "capsOn",
        "frame",
        "translate",
        null
      ],
      "description": "The icon the key draws (src/ui/icons.ts), instead of its default; null: text, never an icon."
    },
    "legendDef": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 16
        },
        {
          "enum": [
            null
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 16
            },
            "parts": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "maxLength": 8
              },
              "description": "Two halves side by side, the second bold in 英数 mode (the 12-key's あ a)."
            },
            "marks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "string",
                "maxLength": 2
              },
              "description": "Marks side by side, each boxed when the layout's dotted lists it (゛゜)."
            },
            "under": {
              "type": "string",
              "maxLength": 16,
              "description": "Drawn small beneath (大⇔小 under ゛゜, the digit under abc)."
            },
            "size": {
              "enum": [
                "key",
                "dual",
                "legend",
                "hint",
                "sub"
              ]
            },
            "tone": {
              "enum": [
                "text",
                "legend",
                "fn"
              ]
            },
            "boxed": {
              "type": "boolean"
            }
          }
        }
      ],
      "description": "Text, null for nothing, or {text | parts | marks, under, size, tone, boxed}; a string is text at the slot's usual size and colour."
    },
    "legends": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tl": {
          "$ref": "#/$defs/legendDef"
        },
        "t": {
          "$ref": "#/$defs/legendDef"
        },
        "tr": {
          "$ref": "#/$defs/legendDef"
        },
        "l": {
          "$ref": "#/$defs/legendDef"
        },
        "c": {
          "$ref": "#/$defs/legendDef"
        },
        "r": {
          "$ref": "#/$defs/legendDef"
        },
        "bl": {
          "$ref": "#/$defs/legendDef"
        },
        "b": {
          "$ref": "#/$defs/legendDef"
        },
        "br": {
          "$ref": "#/$defs/legendDef"
        }
      },
      "description": "What goes where on the key, by slot (tl t tr / l c r / bl b br; c is the label). Replaces what the key's other fields put in those slots."
    },
    "row": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/key"
      }
    },
    "cycles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 8
      },
      "description": "What the modify (゛゜小) key cycles the last typed character through; each string is one cycle, e.g. \"はばぱ\"."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "width": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 16
    },
    "char": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4
    },
    "namedKey": {
      "enum": [
        "Backspace",
        "Enter",
        "Tab",
        "Escape",
        "Delete",
        "Insert",
        "Home",
        "End",
        "PageUp",
        "PageDown",
        "ArrowUp",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6",
        "F7",
        "F8",
        "F9",
        "F10",
        "F11",
        "F12"
      ]
    },
    "charKey": {
      "type": "object",
      "required": [
        "type",
        "char"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "char"
        },
        "char": {
          "$ref": "#/$defs/char"
        },
        "shift": {
          "$ref": "#/$defs/char",
          "description": "Typed with Shift; default: the upper case of char."
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "legends": {
          "$ref": "#/$defs/legends"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "fn": {
          "$ref": "#/$defs/fnKey"
        },
        "long": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/char"
          },
          "description": "Variants offered on a long press, after the key itself and its Shift variant."
        },
        "hint": {
          "$ref": "#/$defs/char",
          "description": "A small legend in the top right corner, e.g. the digit a long press offers."
        },
        "kana": {
          "$ref": "#/$defs/char",
          "description": "A JIS key's kana: typed in かな mode (char and shift are then its Latin legends, typed in 英数 mode)."
        },
        "kanaShift": {
          "$ref": "#/$defs/char",
          "description": "Typed with Shift in かな mode (small kana, punctuation); default: kana."
        },
        "alone": {
          "$ref": "#/$defs/alone"
        }
      }
    },
    "namedKeyKey": {
      "type": "object",
      "required": [
        "type",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "key"
        },
        "key": {
          "$ref": "#/$defs/namedKey"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "legends": {
          "$ref": "#/$defs/legends"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "fn": {
          "$ref": "#/$defs/fnKey"
        },
        "rows": {
          "enum": [
            2,
            3
          ],
          "description": "A key two or three rows high, written once in the top row: the rows below leave room for it, in the same columns (less the notch)."
        },
        "notch": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "How much narrower the lower half is, on the left (the JIS Enter: 0.25)."
        },
        "alone": {
          "$ref": "#/$defs/aloneTall"
        }
      }
    },
    "fnKey": {
      "description": "What the key does while Fn is on.",
      "oneOf": [
        {
          "$ref": "#/$defs/char"
        },
        {
          "type": "object",
          "required": [
            "type",
            "char"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "char"
            },
            "char": {
              "$ref": "#/$defs/char"
            },
            "shift": {
              "$ref": "#/$defs/char"
            },
            "label": {
              "$ref": "#/$defs/label"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "key"
            },
            "key": {
              "$ref": "#/$defs/namedKey"
            },
            "label": {
              "$ref": "#/$defs/label"
            }
          }
        }
      ]
    },
    "modKey": {
      "type": "object",
      "required": [
        "type",
        "mod"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "mod"
        },
        "mod": {
          "enum": [
            "shift",
            "caps",
            "ctrl",
            "alt",
            "super",
            "fn"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "legends": {
          "$ref": "#/$defs/legends"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "alone": {
          "$ref": "#/$defs/alone"
        }
      }
    },
    "actionKey": {
      "type": "object",
      "required": [
        "type",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "action"
        },
        "action": {
          "enum": [
            "hide",
            "next-keyboard",
            "copy",
            "cut",
            "paste",
            "menu",
            "settings",
            "emoji",
            "kaomoji",
            "dictate",
            "abc",
            "modify",
            "undo",
            "eisu",
            "kana",
            "symbols",
            "more-symbols"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "legends": {
          "$ref": "#/$defs/legends"
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "rows": {
          "enum": [
            2,
            3
          ],
          "description": "A key two or three rows high, written once in the top row: the rows below leave room for it, in the same columns (less the notch)."
        },
        "notch": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "How much narrower the lower half is, on the left (the JIS Enter: 0.25)."
        },
        "alone": {
          "$ref": "#/$defs/aloneTall"
        }
      }
    },
    "gap": {
      "type": "object",
      "required": [
        "type",
        "w"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "gap"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "alone": {
          "$ref": "#/$defs/alone"
        }
      }
    },
    "key": {
      "description": "A one-character string is shorthand for a char key.",
      "oneOf": [
        {
          "$ref": "#/$defs/char"
        },
        {
          "$ref": "#/$defs/charKey"
        },
        {
          "$ref": "#/$defs/namedKeyKey"
        },
        {
          "$ref": "#/$defs/modKey"
        },
        {
          "$ref": "#/$defs/actionKey"
        },
        {
          "$ref": "#/$defs/gap"
        },
        {
          "$ref": "#/$defs/flickKey"
        }
      ]
    },
    "layout": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "layout"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "toolbar": {
          "type": "array",
          "maxItems": 10,
          "description": "The strip above the keys. Leave it out for the default (settings, emoji, dictate, copy, cut, paste, menu, hide); [] means none.",
          "items": {
            "$ref": "#/$defs/actionKey"
          }
        },
        "extends": {
          "$ref": "#/$defs/id",
          "description": "Start from this layout: everything not set here (except name and description) comes from it."
        },
        "rows": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            {
              "type": "object",
              "patternProperties": {
                "^[0-7]$": {
                  "$ref": "#/$defs/row"
                }
              },
              "additionalProperties": false,
              "description": "With extends: the rows to replace, by index from 0 at the top, e.g. {\"4\": [...]}."
            }
          ],
          "description": "Every row, top to bottom. Required unless the layout extends another."
        },
        "modify": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "$ref": "#/$defs/cycles"
            }
          ],
          "description": "What the modify (゛゜小) key does: a table id (e.g. \"ja/modify\"), or the cycles themselves."
        },
        "iconSet": {
          "enum": [
            "desktop",
            "phone"
          ],
          "description": "Which keys draw icons: desktop, or phone (also undo, Enter, ← → and a tag-shaped Backspace; font glyphs render tiny in the headset). Default: phone for a large layout."
        },
        "arrowStyle": {
          "enum": [
            "icon",
            "glyph"
          ],
          "description": "Arrow keys as icons where the icon set has them (default), or as text glyphs ←↑↓→."
        },
        "large": {
          "type": "boolean",
          "description": "Bigger key text and icons, as on a phone 12-key."
        },
        "dotted": {
          "type": "string",
          "maxLength": 64,
          "description": "Characters drawn in a dotted box wherever they appear as a legend, label or flick hint, as on JIS keycaps (punctuation, ゛゜)."
        }
      }
    },
    "keyboard": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "keyboard"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "extends": {
          "$ref": "#/$defs/id",
          "description": "Start from this keyboard: everything not set here (except name and description) comes from it; a field set here (e.g. options) replaces its."
        },
        "layout": {
          "$ref": "#/$defs/id"
        },
        "strings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "idleHint": {
              "type": "string",
              "maxLength": 80,
              "description": "Shown where candidates appear while there are none (入力すると、ここに変換候補が出ます)."
            }
          },
          "description": "Text the keyboard shows."
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "letters"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z]+$",
                "maxLength": 16
              },
              "letters": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8,
                "description": "What this mode's letters are called, on the keys back to them (あいう, ABC)."
              },
              "latin": {
                "type": "boolean",
                "description": "This is the keyboard's Latin mode (英数)."
              }
            }
          },
          "description": "The keyboard's modes, the first its default. None: one mode, called ABC."
        },
        "pages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "latin": {
              "oneOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "flick",
                    "qwerty"
                  ],
                  "properties": {
                    "flick": {
                      "$ref": "#/$defs/id"
                    },
                    "qwerty": {
                      "$ref": "#/$defs/id"
                    }
                  }
                }
              ],
              "description": "The layout shown in 英数 mode instead (the 12-key's ABC keys), or two: the qwertyLatin option picks flick or qwerty. Default: the main layout."
            },
            "symbols": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/id"
              },
              "description": "The symbols pages: the symbols key (?123) opens the first, the more-symbols key (=\\<) goes between them. Typed in the current mode."
            }
          },
          "description": "The keyboard's other pages; its layout is the main one."
        },
        "composer": {
          "enum": [
            "direct",
            "kana",
            "romaji"
          ],
          "description": "direct: keys type at once. kana: typed kana wait in a reading buffer shown in the bar until confirmed (確定) or converted (変換). romaji: the same buffer; letters become kana with the keyboard's table."
        },
        "lexicon": {
          "$ref": "#/$defs/id",
          "description": "Word list for suggestions: packs/<ns>/<name>.tsv (word<TAB>count). On a Japanese keyboard, for its 英数 mode (shown as candidates)."
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "description": "The options this keyboard offers in settings, with their defaults.",
          "properties": {
            "tapCycle": {
              "type": "boolean",
              "description": "Tapping a flick key again goes to its next kana (→ moves on); off: it types the kana again."
            },
            "candidatesLeft": {
              "type": "boolean",
              "description": "Reading and candidates in a panel left of the keys (fjk), instead of the top bar."
            },
            "flickHints": {
              "type": "boolean",
              "description": "Show each flick key's other kana small at its edges."
            },
            "romajiInput": {
              "type": "boolean",
              "description": "A JIS kana keyboard types romaji instead (its Latin legends through the keyboard's table); off: kana input."
            },
            "qwertyLatin": {
              "type": "boolean",
              "description": "英数 mode shows the keyboard's qwerty latin page instead of its flick one (the 12-key: QWERTY or flick letters)."
            },
            "swipe": {
              "type": "boolean",
              "description": "Swipe typing: trace a word across the letter keys. Needs features.swipe."
            }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "description": "What the keyboard can do beyond typing keys.",
          "properties": {
            "swipe": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lexicon"
              ],
              "properties": {
                "lexicon": {
                  "$ref": "#/$defs/id",
                  "description": "The word list a swipe is decoded against (packs/<ns>/<name>.tsv)."
                }
              },
              "description": "Swipe typing over the letter keys (the swipe option turns it on and off). On a Japanese keyboard, in its 英数 mode."
            }
          }
        },
        "converter": {
          "enum": [
            "anthy"
          ],
          "description": "The engine that converts the reading (with composer kana): anthy, from the system's libanthy."
        },
        "table": {
          "$ref": "#/$defs/id",
          "description": "The table (kind table) for composer romaji."
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "colors"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "theme"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "colors": {
          "type": "object",
          "required": [
            "surface",
            "key",
            "keyText",
            "modifier",
            "accent"
          ],
          "additionalProperties": false,
          "properties": {
            "surface": {
              "$ref": "#/$defs/color"
            },
            "key": {
              "$ref": "#/$defs/color"
            },
            "keyText": {
              "$ref": "#/$defs/color"
            },
            "modifier": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color"
            },
            "legend": {
              "$ref": "#/$defs/color",
              "description": "Small Shift legends; default keyText."
            },
            "fnLegend": {
              "$ref": "#/$defs/color",
              "description": "Small Fn legends; default accent."
            },
            "hover": {
              "$ref": "#/$defs/color",
              "description": "Key under the laser; default modifier."
            },
            "accentText": {
              "$ref": "#/$defs/color",
              "description": "Text on the accent (a selected candidate, a locked key); default surface."
            },
            "fnText": {
              "$ref": "#/$defs/color",
              "description": "Text on the Fn colour (Fn locked); default surface."
            },
            "error": {
              "$ref": "#/$defs/color",
              "description": "Errors (a failed dictation, a pack that did not load); default fnLegend."
            },
            "divider": {
              "$ref": "#/$defs/color",
              "description": "Hairlines between candidates and sections; default modifier."
            },
            "ring": {
              "$ref": "#/$defs/color",
              "description": "Outline of an armed modifier, a hovered setting, a selected item; default accent."
            },
            "indicator": {
              "$ref": "#/$defs/color",
              "description": "Outline marking the current input mode (英数 / かな); default accent."
            }
          }
        },
        "tone": {
          "enum": [
            "dark",
            "light"
          ],
          "description": "dark (default): pressed and raised states shift lighter; light: they shift darker."
        },
        "radiusSmall": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "A focused reading segment; default 3."
        },
        "radiusPill": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "Switches in settings; default 13."
        },
        "fontCjk": {
          "type": "string",
          "maxLength": 120,
          "description": "Japanese fonts tried first where Japanese is drawn as text; default \"Noto Sans CJK JP\", \"Noto Sans JP\"."
        },
        "shadow": {
          "type": "string",
          "maxLength": 120,
          "description": "CSS box-shadow for popups and the drag ghost; default 0 2px 10px rgba(0, 0, 0, 0.6)."
        },
        "shadowLarge": {
          "type": "string",
          "maxLength": 120,
          "description": "CSS box-shadow for the emoji preview; default 0 4px 14px rgba(0,0,0,0.6)."
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "font": {
          "type": "string",
          "maxLength": 120
        },
        "followSteam": {
          "type": "boolean",
          "description": "Take colours from Steam's own keyboard theme at runtime."
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
      "description": "#rrggbb, or #rrggbbaa with transparency."
    },
    "flickKey": {
      "type": "object",
      "required": [
        "type",
        "flick"
      ],
      "additionalProperties": false,
      "description": "A 12-key flick key.",
      "properties": {
        "type": {
          "const": "flick"
        },
        "flick": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 4
          },
          "description": "What it types for [tap, flick left, up, right, down]; \"\" where a direction has nothing. The tap entry is required."
        },
        "cycle": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4
          },
          "description": "What tapping it again goes through when the keyboard's tapCycle option is on; default: its flick entries."
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "legends": {
          "$ref": "#/$defs/legends"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "hints": {
          "type": "boolean",
          "description": "Always show the other directions small at the key's edges, whatever the flick hints option says (e.g. a punctuation key)."
        },
        "sub": {
          "$ref": "#/$defs/label",
          "description": "A small legend beneath the label (the ABC keys' digit); not shown with flick hints."
        },
        "alone": {
          "$ref": "#/$defs/alone"
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name"
      ],
      "additionalProperties": false,
      "description": "A conversion table: entries (romaji to kana) or cycles (゛゜小).",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "table"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4000,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "string",
              "maxLength": 16
            }
          },
          "description": "[input, output] or [input, output, letters left pending] (kk → っ, k waits)."
        },
        "cycles": {
          "$ref": "#/$defs/cycles"
        }
      }
    },
    "alone": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "w": {
          "$ref": "#/$defs/width"
        }
      },
      "description": "What this key becomes when 🌐 is hidden (one keyboard in your list): its width there. The layout's rows must still be as wide as before."
    },
    "aloneTall": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "w": {
          "$ref": "#/$defs/width"
        },
        "rows": {
          "enum": [
            1,
            2,
            3
          ]
        }
      },
      "description": "What this key becomes when 🌐 is hidden (one keyboard in your list): its width and how many rows high. The layout's rows must still be as wide as before."
    },
    "pickerText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$",
      "description": "What the picker shows and types: up to 64 characters on one line."
    },
    "pickerWords": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
      }
    },
    "pickerItem": {
      "description": "One thing to pick: its text; or its text with words that could call it up; or an emoji with its five skin tones.",
      "oneOf": [
        {
          "$ref": "#/$defs/pickerText"
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "$ref": "#/$defs/pickerText"
            },
            "reading": {
              "$ref": "#/$defs/pickerWords",
              "description": "Words in hiragana that could call the item up. Kept by the sidecar."
            },
            "tags": {
              "$ref": "#/$defs/pickerWords",
              "description": "Words that describe the item. Kept by the sidecar."
            }
          }
        },
        {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/pickerText"
          },
          "description": "[base, light, medium-light, medium, medium-dark, dark]: the tones are offered when the set has \"tones\": true."
        }
      ]
    },
    "pickerCategory": {
      "type": "object",
      "required": [
        "id",
        "name",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$",
          "description": "Unique in its set. recent, favorites and steam-… are the picker's own."
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "icon": {
          "$ref": "#/$defs/pickerIcon",
          "description": "The category's tab. Without one the tab reads its name, and the name stands beside the category in the grid."
        },
        "items": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 2000,
              "items": {
                "$ref": "#/$defs/pickerItem"
              }
            },
            {
              "type": "object",
              "required": [
                "file"
              ],
              "additionalProperties": false,
              "description": "The items are in a data file, for a list too long to write here.",
              "properties": {
                "file": {
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^[a-z0-9-]+/[a-z0-9-]+\\.data$",
                  "description": "<namespace>/<name>.data, JSON: {\"groups\": [{\"id\": …, \"items\": […]}]}. A copy in your own packs folder is read instead of the bundled one."
                },
                "group": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,32}$",
                  "description": "The group in the file whose items these are; default: the category's id."
                }
              }
            }
          ]
        }
      }
    },
    "pickerIcon": {
      "enum": [
        "settings",
        "emoji",
        "dictate",
        "copy",
        "cut",
        "paste",
        "hide",
        "close",
        "back",
        "menu",
        "recent",
        "favorites",
        "smileys",
        "people",
        "animals",
        "food",
        "travel",
        "activities",
        "objects",
        "symbols",
        "flags",
        "clear",
        "emoticons",
        "stickers",
        "effects",
        "backspace",
        "undo",
        "backspaceTag",
        "enter",
        "left",
        "space",
        "right",
        "up",
        "down",
        "chevron",
        "globe",
        "shift",
        "shiftLocked",
        "caps",
        "capsOn",
        "frame",
        "translate"
      ],
      "description": "An icon from src/ui/icons.ts."
    },
    "picker": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "icon",
        "categories"
      ],
      "additionalProperties": false,
      "description": "A set the picker shows (emoji, kaomoji, your own): categories of things to tap and type.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "picker"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "icon": {
          "$ref": "#/$defs/pickerIcon",
          "description": "Shown on the picker's mode key when this set is the next one."
        },
        "cellWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 4,
          "description": "How wide a cell is, in emoji cells: 1 (the default) for single characters, 2.5 for kaomoji. Above 1, each item is shrunk to fit its cell."
        },
        "tones": {
          "type": "boolean",
          "description": "Items written with their skin tones offer them when held, and are typed in the tone last chosen."
        },
        "steam": {
          "type": "boolean",
          "description": "The user's Steam emoticons, stickers and room effects follow the categories."
        },
        "favorites": {
          "type": "boolean",
          "description": "A Favorites section, filled by drag and drop from Recent."
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/pickerCategory"
          },
          "description": "In the order their tabs show. In a pack of yours with a bundled set's id, a category with a bundled category's id replaces it and any other is added after them."
        }
      }
    }
  }
}
