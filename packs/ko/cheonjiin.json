{
  "$schema": "../pack.schema.json",
  "schemaVersion": 1,
  "kind": "layout",
  "id": "ko/cheonjiin",
  "name": "Korean 12-key (천지인)",
  "description": "The 천지인 phone keypad (KS X 5020, 2011): the strokes ㅣ ㆍ ㅡ make every vowel (ㅣ ㆍ → ㅏ), and a consonant key tapped again goes on to its next consonant (ㄱ → ㅋ → ㄲ); → ends a tap, to type the same key again (학교). The punctuation keys cycle too (. , and ? !). A long press types the digit in a key's corner. Round the keypad: 한자, the arrows, 한/영, Space, ?123 and Enter.",
  "large": true,
  "rows": [
    [{"action": "convert", "label": "한자"}, {"char": "ㅣ", "long": ["1"], "hint": "1"}, {"char": "ㆍ", "long": ["2"], "hint": "2"}, {"char": "ㅡ", "long": ["3"], "hint": "3"}, {"key": "Backspace"}],
    [{"key": "ArrowLeft"}, {"cycle": ["ㄱ", "ㅋ", "ㄲ"], "label": "ㄱㅋ", "long": ["4"], "hint": "4"}, {"cycle": ["ㄴ", "ㄹ"], "label": "ㄴㄹ", "long": ["5"], "hint": "5"}, {"cycle": ["ㄷ", "ㅌ", "ㄸ"], "label": "ㄷㅌ", "long": ["6"], "hint": "6"}, {"key": "ArrowRight"}],
    [{"action": "mode", "legends": {"c": {"parts": ["한", "영"]}}}, {"cycle": ["ㅂ", "ㅍ", "ㅃ"], "label": "ㅂㅍ", "long": ["7"], "hint": "7"}, {"cycle": ["ㅅ", "ㅎ", "ㅆ"], "label": "ㅅㅎ", "long": ["8"], "hint": "8"}, {"cycle": ["ㅈ", "ㅊ", "ㅉ"], "label": "ㅈㅊ", "long": ["9"], "hint": "9"}, {"char": " "}],
    [{"action": "next-keyboard", "w": 0.5}, {"action": "symbols", "w": 0.5, "alone": {"w": 1}}, {"cycle": [".", ","], "label": ".,"}, {"cycle": ["ㅇ", "ㅁ"], "label": "ㅇㅁ", "long": ["0"], "hint": "0"}, {"cycle": ["?", "!"], "label": "?!"}, {"key": "Enter"}]
  ]
}
