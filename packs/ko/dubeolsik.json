{
  "$schema": "../pack.schema.json",
  "schemaVersion": 1,
  "kind": "layout",
  "id": "ko/dubeolsik",
  "name": "Korean 2-set (두벌식)",
  "description": "The standard 2-set layout (KS X 5002): consonants on the left, vowels on the right, at the QWERTY positions. Shift gives the tense consonants ㅃㅉㄸㄲㅆ and ㅒㅖ. The bottom row is the English one with 한자 left of Space and 한/영 right of it (ko/qwerty, the Latin mode).",
  "extends": "ko/qwerty",
  "rows": {
    "1": [{"key": "Tab", "w": 1.5}, {"char": "ㅂ", "shift": "ㅃ"}, {"char": "ㅈ", "shift": "ㅉ"}, {"char": "ㄷ", "shift": "ㄸ"}, {"char": "ㄱ", "shift": "ㄲ"}, {"char": "ㅅ", "shift": "ㅆ"}, "ㅛ", "ㅕ", "ㅑ", {"char": "ㅐ", "shift": "ㅒ"}, {"char": "ㅔ", "shift": "ㅖ"}, {"char": "[", "shift": "{"}, {"char": "]", "shift": "}"}, {"char": "\\", "shift": "|", "w": 1.5}],
    "2": [{"mod": "caps", "w": 1.75}, "ㅁ", "ㄴ", "ㅇ", "ㄹ", "ㅎ", "ㅗ", "ㅓ", "ㅏ", "ㅣ", {"char": ";", "shift": ":"}, {"char": "'", "shift": "\""}, {"key": "Enter", "w": 2.25}],
    "3": [{"mod": "shift", "w": 2.25}, "ㅋ", "ㅌ", "ㅊ", "ㅍ", "ㅠ", "ㅜ", "ㅡ", {"char": ",", "shift": "<"}, {"char": ".", "shift": ">"}, {"char": "/", "shift": "?", "alone": {"w": 1.25}}, {"key": "ArrowUp", "alone": {"w": 1.25}}, {"mod": "shift", "w": 1.75, "alone": {"w": 1.25}}]
  }
}
