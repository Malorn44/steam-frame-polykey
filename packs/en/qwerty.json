    [{"char": "`", "shift": "~", "fn": {"key": "Escape"}}, {"char": "1", "shift": "!", "fn": {"key": "F1"}}, {"char": "2", "shift": "@", "fn": {"key": "F2"}}, {"char": "3", "shift": "#", "fn": {"key": "F3"}}, {"char": "4", "shift": "$", "fn": {"key": "F4"}}, {"char": "5", "shift": "%", "fn": {"key": "F5"}}, {"char": "6", "shift": "^", "fn": {"key": "F6"}}, {"char": "7", "shift": "&", "fn": {"key": "F7"}}, {"char": "8", "shift": "*", "fn": {"key": "F8"}}, {"char": "9", "shift": "(", "fn": {"key": "F9"}}, {"char": "0", "shift": ")", "fn": {"key": "F10"}, "long": ["°"]}, {"char": "-", "shift": "_", "fn": {"key": "F11"}, "long": ["–", "—", "·"]}, {"char": "=", "shift": "+", "fn": {"key": "F12"}}, {"key": "Backspace", "w": 2}],
