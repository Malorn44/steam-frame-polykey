{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polykey/schema/pack.schema.json",
  "title": "polykey pack item",
  "description": "One layout, keyboard or theme. Files live in packs/<namespace>/; ids are <namespace>/<name>.",
  "oneOf": [
    {
      "$ref": "#/$defs/layout"
    },
    {
      "$ref": "#/$defs/keyboard"
    },
    {
      "$ref": "#/$defs/theme"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "maxLength": 80
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "width": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 16
    },
    "char": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4
    },
    "namedKey": {
      "enum": [
        "Backspace",
        "Enter",
        "Tab",
        "Escape",
        "Delete",
        "Insert",
        "Home",
        "End",
        "PageUp",
        "PageDown",
        "ArrowUp",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6",
        "F7",
        "F8",
        "F9",
        "F10",
        "F11",
        "F12"
      ]
    },
    "charKey": {
      "type": "object",
      "required": [
        "type",
        "char"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "char"
        },
        "char": {
          "$ref": "#/$defs/char"
        },
        "shift": {
          "$ref": "#/$defs/char",
          "description": "Typed with Shift; default: the upper case of char."
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "fn": {
          "$ref": "#/$defs/fnKey"
        },
        "long": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/char"
          },
          "description": "Variants offered on a long press, after the key itself and its Shift variant."
        }
      }
    },
    "namedKeyKey": {
      "type": "object",
      "required": [
        "type",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "key"
        },
        "key": {
          "$ref": "#/$defs/namedKey"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "fn": {
          "$ref": "#/$defs/fnKey"
        }
      }
    },
    "fnKey": {
      "description": "What the key does while Fn is on.",
      "oneOf": [
        {
          "$ref": "#/$defs/char"
        },
        {
          "type": "object",
          "required": [
            "type",
            "char"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "char"
            },
            "char": {
              "$ref": "#/$defs/char"
            },
            "shift": {
              "$ref": "#/$defs/char"
            },
            "label": {
              "$ref": "#/$defs/label"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "key"
            },
            "key": {
              "$ref": "#/$defs/namedKey"
            },
            "label": {
              "$ref": "#/$defs/label"
            }
          }
        }
      ]
    },
    "modKey": {
      "type": "object",
      "required": [
        "type",
        "mod"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "mod"
        },
        "mod": {
          "enum": [
            "shift",
            "caps",
            "ctrl",
            "alt",
            "super",
            "fn"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        }
      }
    },
    "actionKey": {
      "type": "object",
      "required": [
        "type",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "action"
        },
        "action": {
          "enum": [
            "hide",
            "next-keyboard",
            "copy",
            "cut",
            "paste",
            "menu",
            "settings",
            "emoji",
            "dictate"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        }
      }
    },
    "gap": {
      "type": "object",
      "required": [
        "type",
        "w"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "gap"
        },
        "w": {
          "$ref": "#/$defs/width"
        }
      }
    },
    "key": {
      "description": "A one-character string is shorthand for a char key.",
      "oneOf": [
        {
          "$ref": "#/$defs/char"
        },
        {
          "$ref": "#/$defs/charKey"
        },
        {
          "$ref": "#/$defs/namedKeyKey"
        },
        {
          "$ref": "#/$defs/modKey"
        },
        {
          "$ref": "#/$defs/actionKey"
        },
        {
          "$ref": "#/$defs/gap"
        }
      ]
    },
    "layout": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "layout"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "toolbar": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/actionKey"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "$ref": "#/$defs/key"
            }
          }
        }
      }
    },
    "keyboard": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "keyboard"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "layout": {
          "$ref": "#/$defs/id"
        },
        "composer": {
          "enum": [
            "direct"
          ]
        },
        "lexicon": {
          "$ref": "#/$defs/id",
          "description": "Word list for suggestions: packs/<ns>/<name>.tsv (word<TAB>count)."
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "colors"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "theme"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "colors": {
          "type": "object",
          "required": [
            "surface",
            "key",
            "keyText",
            "modifier",
            "accent"
          ],
          "additionalProperties": false,
          "properties": {
            "surface": {
              "$ref": "#/$defs/color"
            },
            "key": {
              "$ref": "#/$defs/color"
            },
            "keyText": {
              "$ref": "#/$defs/color"
            },
            "modifier": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color"
            },
            "legend": {
              "$ref": "#/$defs/color",
              "description": "Small Shift legends; default keyText."
            },
            "fnLegend": {
              "$ref": "#/$defs/color",
              "description": "Small Fn legends; default accent."
            },
            "hover": {
              "$ref": "#/$defs/color",
              "description": "Key under the laser; default a lighter key."
            }
          }
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "font": {
          "type": "string",
          "maxLength": 120
        },
        "followSteam": {
          "type": "boolean",
          "description": "Take colours from Steam's own keyboard theme at runtime."
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  }
}
