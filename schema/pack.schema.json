{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polykey/schema/pack.schema.json",
  "title": "polykey pack item",
  "description": "One layout, keyboard, theme or table. Files live in packs/<namespace>/; ids are <namespace>/<name>.",
  "oneOf": [
    {
      "$ref": "#/$defs/layout"
    },
    {
      "$ref": "#/$defs/keyboard"
    },
    {
      "$ref": "#/$defs/theme"
    },
    {
      "$ref": "#/$defs/table"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "maxLength": 80
    },
    "row": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/key"
      }
    },
    "cycles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 8
      },
      "description": "What the modify (゛゜小) key cycles the last typed character through; each string is one cycle, e.g. \"はばぱ\"."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "width": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 16
    },
    "char": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4
    },
    "namedKey": {
      "enum": [
        "Backspace",
        "Enter",
        "Tab",
        "Escape",
        "Delete",
        "Insert",
        "Home",
        "End",
        "PageUp",
        "PageDown",
        "ArrowUp",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6",
        "F7",
        "F8",
        "F9",
        "F10",
        "F11",
        "F12"
      ]
    },
    "charKey": {
      "type": "object",
      "required": [
        "type",
        "char"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "char"
        },
        "char": {
          "$ref": "#/$defs/char"
        },
        "shift": {
          "$ref": "#/$defs/char",
          "description": "Typed with Shift; default: the upper case of char."
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "fn": {
          "$ref": "#/$defs/fnKey"
        },
        "long": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/char"
          },
          "description": "Variants offered on a long press, after the key itself and its Shift variant."
        },
        "hint": {
          "$ref": "#/$defs/char",
          "description": "A small legend in the top right corner, e.g. the digit a long press offers."
        },
        "kana": {
          "$ref": "#/$defs/char",
          "description": "A JIS key's kana: typed in かな mode (char and shift are then its Latin legends, typed in 英数 mode)."
        },
        "kanaShift": {
          "$ref": "#/$defs/char",
          "description": "Typed with Shift in かな mode (small kana, punctuation); default: kana."
        }
      }
    },
    "namedKeyKey": {
      "type": "object",
      "required": [
        "type",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "key"
        },
        "key": {
          "$ref": "#/$defs/namedKey"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "fn": {
          "$ref": "#/$defs/fnKey"
        },
        "tall": {
          "enum": [
            "top",
            "bottom"
          ],
          "description": "The top or bottom half of a key two rows high (the JIS Enter); the halves act as one key."
        }
      }
    },
    "fnKey": {
      "description": "What the key does while Fn is on.",
      "oneOf": [
        {
          "$ref": "#/$defs/char"
        },
        {
          "type": "object",
          "required": [
            "type",
            "char"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "char"
            },
            "char": {
              "$ref": "#/$defs/char"
            },
            "shift": {
              "$ref": "#/$defs/char"
            },
            "label": {
              "$ref": "#/$defs/label"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "key"
            },
            "key": {
              "$ref": "#/$defs/namedKey"
            },
            "label": {
              "$ref": "#/$defs/label"
            }
          }
        }
      ]
    },
    "modKey": {
      "type": "object",
      "required": [
        "type",
        "mod"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "mod"
        },
        "mod": {
          "enum": [
            "shift",
            "caps",
            "ctrl",
            "alt",
            "super",
            "fn"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        }
      }
    },
    "actionKey": {
      "type": "object",
      "required": [
        "type",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "action"
        },
        "action": {
          "enum": [
            "hide",
            "next-keyboard",
            "copy",
            "cut",
            "paste",
            "menu",
            "settings",
            "emoji",
            "dictate",
            "abc",
            "modify",
            "undo",
            "eisu",
            "kana",
            "symbols",
            "more-symbols"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "tall": {
          "enum": [
            "top",
            "bottom"
          ],
          "description": "The top or bottom half of a key two rows high; the halves act as one key."
        }
      }
    },
    "gap": {
      "type": "object",
      "required": [
        "type",
        "w"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "gap"
        },
        "w": {
          "$ref": "#/$defs/width"
        }
      }
    },
    "key": {
      "description": "A one-character string is shorthand for a char key.",
      "oneOf": [
        {
          "$ref": "#/$defs/char"
        },
        {
          "$ref": "#/$defs/charKey"
        },
        {
          "$ref": "#/$defs/namedKeyKey"
        },
        {
          "$ref": "#/$defs/modKey"
        },
        {
          "$ref": "#/$defs/actionKey"
        },
        {
          "$ref": "#/$defs/gap"
        },
        {
          "$ref": "#/$defs/flickKey"
        }
      ]
    },
    "layout": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "layout"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "toolbar": {
          "type": "array",
          "maxItems": 10,
          "description": "The strip above the keys. Leave it out for the default (settings, emoji, dictate, copy, cut, paste, menu, hide); [] means none.",
          "items": {
            "$ref": "#/$defs/actionKey"
          }
        },
        "extends": {
          "$ref": "#/$defs/id",
          "description": "Start from this layout: everything not set here (except name and description) comes from it."
        },
        "rows": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/row"
              }
            },
            {
              "type": "object",
              "patternProperties": {
                "^[0-7]$": {
                  "$ref": "#/$defs/row"
                }
              },
              "additionalProperties": false,
              "description": "With extends: the rows to replace, by index from 0 at the top, e.g. {\"4\": [...]}."
            }
          ],
          "description": "Every row, top to bottom. Required unless the layout extends another."
        },
        "modify": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "$ref": "#/$defs/cycles"
            }
          ],
          "description": "What the modify (゛゜小) key does: a table id (e.g. \"ja/modify\"), or the cycles themselves."
        },
        "large": {
          "type": "boolean",
          "description": "Bigger key text and icons, as on a phone 12-key."
        },
        "dotted": {
          "type": "string",
          "maxLength": 64,
          "description": "Legends drawn in a dotted box, as on JIS keycaps (punctuation)."
        }
      }
    },
    "keyboard": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "keyboard"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "layout": {
          "$ref": "#/$defs/id"
        },
        "latinLayout": {
          "$ref": "#/$defs/id",
          "description": "The layout shown in 英数 mode instead (the 12-key's ABC keys); default: the same layout."
        },
        "qwertyLayout": {
          "$ref": "#/$defs/id",
          "description": "The 英数 layout when the qwertyLatin option is on."
        },
        "symbolsLayout": {
          "$ref": "#/$defs/id",
          "description": "The layout the symbols key (?123) shows: numbers and symbols, typed in the current mode."
        },
        "moreSymbolsLayout": {
          "$ref": "#/$defs/id",
          "description": "The second symbols page, from the more-symbols key (=\\<) on the first."
        },
        "composer": {
          "enum": [
            "direct",
            "kana",
            "romaji"
          ],
          "description": "direct: keys type at once. kana: typed kana wait in a reading buffer shown in the bar until confirmed (確定) or converted (変換). romaji: the same buffer; letters become kana with the keyboard's table."
        },
        "lexicon": {
          "$ref": "#/$defs/id",
          "description": "Word list for suggestions: packs/<ns>/<name>.tsv (word<TAB>count). On a Japanese keyboard, for its 英数 mode (shown as candidates)."
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "description": "The options this keyboard offers in settings, with their defaults.",
          "properties": {
            "tapCycle": {
              "type": "boolean",
              "description": "Tapping a flick key again goes to its next kana (→ moves on); off: it types the kana again."
            },
            "candidatesLeft": {
              "type": "boolean",
              "description": "Reading and candidates in a panel left of the keys (fjk), instead of the top bar."
            },
            "flickHints": {
              "type": "boolean",
              "description": "Show each flick key's other kana small at its edges."
            },
            "romajiInput": {
              "type": "boolean",
              "description": "A JIS kana keyboard types romaji instead (its Latin legends through the keyboard's table); off: kana input."
            },
            "qwertyLatin": {
              "type": "boolean",
              "description": "英数 mode shows the keyboard's qwertyLayout instead of its latinLayout (the 12-key: QWERTY or flick letters)."
            }
          }
        },
        "converter": {
          "enum": [
            "anthy"
          ],
          "description": "The engine that converts the reading (with composer kana): anthy, from the system's libanthy."
        },
        "table": {
          "$ref": "#/$defs/id",
          "description": "The table (kind table) for composer romaji."
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "colors"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "theme"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "colors": {
          "type": "object",
          "required": [
            "surface",
            "key",
            "keyText",
            "modifier",
            "accent"
          ],
          "additionalProperties": false,
          "properties": {
            "surface": {
              "$ref": "#/$defs/color"
            },
            "key": {
              "$ref": "#/$defs/color"
            },
            "keyText": {
              "$ref": "#/$defs/color"
            },
            "modifier": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color"
            },
            "legend": {
              "$ref": "#/$defs/color",
              "description": "Small Shift legends; default keyText."
            },
            "fnLegend": {
              "$ref": "#/$defs/color",
              "description": "Small Fn legends; default accent."
            },
            "hover": {
              "$ref": "#/$defs/color",
              "description": "Key under the laser; default modifier."
            },
            "accentText": {
              "$ref": "#/$defs/color",
              "description": "Text on the accent (a selected candidate, a locked key); default surface."
            },
            "fnText": {
              "$ref": "#/$defs/color",
              "description": "Text on the Fn colour (Fn locked); default surface."
            },
            "divider": {
              "$ref": "#/$defs/color",
              "description": "Hairlines between candidates and sections; default modifier."
            },
            "ring": {
              "$ref": "#/$defs/color",
              "description": "Outline of an armed modifier, a hovered setting, a selected item; default accent."
            },
            "indicator": {
              "$ref": "#/$defs/color",
              "description": "Outline marking the current input mode (英数 / かな); default accent."
            }
          }
        },
        "tone": {
          "enum": [
            "dark",
            "light"
          ],
          "description": "dark (default): pressed and raised states shift lighter; light: they shift darker."
        },
        "radiusSmall": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "A focused reading segment; default 3."
        },
        "radiusBox": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "A dotted legend box (JIS); default 1."
        },
        "radiusPill": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "Switches in settings; default 13."
        },
        "fontCjk": {
          "type": "string",
          "maxLength": 120,
          "description": "Japanese fonts tried first where Japanese is drawn as text; default \"Noto Sans CJK JP\", \"Noto Sans JP\"."
        },
        "shadow": {
          "type": "string",
          "maxLength": 120,
          "description": "CSS box-shadow for popups and the drag ghost; default 0 2px 10px rgba(0, 0, 0, 0.6)."
        },
        "shadowLarge": {
          "type": "string",
          "maxLength": 120,
          "description": "CSS box-shadow for the emoji preview; default 0 4px 14px rgba(0,0,0,0.6)."
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "font": {
          "type": "string",
          "maxLength": 120
        },
        "followSteam": {
          "type": "boolean",
          "description": "Take colours from Steam's own keyboard theme at runtime."
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
      "description": "#rrggbb, or #rrggbbaa with transparency."
    },
    "flickKey": {
      "type": "object",
      "required": [
        "type",
        "flick"
      ],
      "additionalProperties": false,
      "description": "A 12-key flick key.",
      "properties": {
        "type": {
          "const": "flick"
        },
        "flick": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 4
          },
          "description": "What it types for [tap, flick left, up, right, down]; \"\" where a direction has nothing. The tap entry is required."
        },
        "cycle": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4
          },
          "description": "What tapping it again goes through when the keyboard's tapCycle option is on; default: its flick entries."
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "hints": {
          "type": "boolean",
          "description": "Always show the other directions small at the key's edges, whatever the flick hints option says (e.g. a punctuation key)."
        },
        "sub": {
          "$ref": "#/$defs/label",
          "description": "A small legend beneath the label (the ABC keys' digit); not shown with flick hints."
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name"
      ],
      "additionalProperties": false,
      "description": "A conversion table: entries (romaji to kana) or cycles (゛゜小).",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "table"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4000,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "string",
              "maxLength": 16
            }
          },
          "description": "[input, output] or [input, output, letters left pending] (kk → っ, k waits)."
        },
        "cycles": {
          "$ref": "#/$defs/cycles"
        }
      }
    }
  }
}
