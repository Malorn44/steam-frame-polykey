{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polykey/schema/pack.schema.json",
  "title": "polykey pack item",
  "description": "One layout, keyboard, theme or table. Files live in packs/<namespace>/; ids are <namespace>/<name>.",
  "oneOf": [
    {
      "$ref": "#/$defs/layout"
    },
    {
      "$ref": "#/$defs/keyboard"
    },
    {
      "$ref": "#/$defs/theme"
    },
    {
      "$ref": "#/$defs/table"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "maxLength": 80
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "width": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 16
    },
    "char": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4
    },
    "namedKey": {
      "enum": [
        "Backspace",
        "Enter",
        "Tab",
        "Escape",
        "Delete",
        "Insert",
        "Home",
        "End",
        "PageUp",
        "PageDown",
        "ArrowUp",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6",
        "F7",
        "F8",
        "F9",
        "F10",
        "F11",
        "F12"
      ]
    },
    "charKey": {
      "type": "object",
      "required": [
        "type",
        "char"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "char"
        },
        "char": {
          "$ref": "#/$defs/char"
        },
        "shift": {
          "$ref": "#/$defs/char",
          "description": "Typed with Shift; default: the upper case of char."
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "fn": {
          "$ref": "#/$defs/fnKey"
        },
        "long": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/char"
          },
          "description": "Variants offered on a long press, after the key itself and its Shift variant."
        },
        "kana": {
          "$ref": "#/$defs/char",
          "description": "A JIS key's kana: typed in かな mode (char and shift are then its Latin legends, typed in 英数 mode)."
        },
        "kanaShift": {
          "$ref": "#/$defs/char",
          "description": "Typed with Shift in かな mode (small kana, punctuation); default: kana."
        }
      }
    },
    "namedKeyKey": {
      "type": "object",
      "required": [
        "type",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "key"
        },
        "key": {
          "$ref": "#/$defs/namedKey"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "fn": {
          "$ref": "#/$defs/fnKey"
        },
        "tall": {
          "enum": [
            "top",
            "bottom"
          ],
          "description": "The top or bottom half of a key two rows high (the JIS Enter); the halves act as one key."
        }
      }
    },
    "fnKey": {
      "description": "What the key does while Fn is on.",
      "oneOf": [
        {
          "$ref": "#/$defs/char"
        },
        {
          "type": "object",
          "required": [
            "type",
            "char"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "char"
            },
            "char": {
              "$ref": "#/$defs/char"
            },
            "shift": {
              "$ref": "#/$defs/char"
            },
            "label": {
              "$ref": "#/$defs/label"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "key"
            },
            "key": {
              "$ref": "#/$defs/namedKey"
            },
            "label": {
              "$ref": "#/$defs/label"
            }
          }
        }
      ]
    },
    "modKey": {
      "type": "object",
      "required": [
        "type",
        "mod"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "mod"
        },
        "mod": {
          "enum": [
            "shift",
            "caps",
            "ctrl",
            "alt",
            "super",
            "fn"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        }
      }
    },
    "actionKey": {
      "type": "object",
      "required": [
        "type",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "action"
        },
        "action": {
          "enum": [
            "hide",
            "next-keyboard",
            "copy",
            "cut",
            "paste",
            "menu",
            "settings",
            "emoji",
            "dictate",
            "abc",
            "modify",
            "undo",
            "eisu",
            "kana"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        }
      }
    },
    "gap": {
      "type": "object",
      "required": [
        "type",
        "w"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "gap"
        },
        "w": {
          "$ref": "#/$defs/width"
        }
      }
    },
    "key": {
      "description": "A one-character string is shorthand for a char key.",
      "oneOf": [
        {
          "$ref": "#/$defs/char"
        },
        {
          "$ref": "#/$defs/charKey"
        },
        {
          "$ref": "#/$defs/namedKeyKey"
        },
        {
          "$ref": "#/$defs/modKey"
        },
        {
          "$ref": "#/$defs/actionKey"
        },
        {
          "$ref": "#/$defs/gap"
        },
        {
          "$ref": "#/$defs/flickKey"
        }
      ]
    },
    "layout": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "layout"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "toolbar": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/actionKey"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "$ref": "#/$defs/key"
            }
          }
        },
        "modify": {
          "type": "array",
          "maxItems": 80,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 8
          },
          "description": "What the modify (゛゜小) key cycles the last typed character through; each string is one cycle, e.g. \"はばぱ\"."
        },
        "large": {
          "type": "boolean",
          "description": "Bigger key text and icons, as on a phone 12-key."
        },
        "dotted": {
          "type": "string",
          "maxLength": 64,
          "description": "Legends drawn in a dotted box, as on JIS keycaps (punctuation)."
        }
      }
    },
    "keyboard": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "keyboard"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "layout": {
          "$ref": "#/$defs/id"
        },
        "composer": {
          "enum": [
            "direct",
            "kana",
            "romaji"
          ],
          "description": "direct: keys type at once. kana: typed kana wait in a reading buffer shown in the bar until confirmed (確定) or converted (変換). romaji: the same buffer; letters become kana with the keyboard's table."
        },
        "lexicon": {
          "$ref": "#/$defs/id",
          "description": "Word list for suggestions: packs/<ns>/<name>.tsv (word<TAB>count)."
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "description": "The options this keyboard offers in settings, with their defaults.",
          "properties": {
            "tapCycle": {
              "type": "boolean",
              "description": "Tapping a flick key again goes to its next kana (→ moves on); off: it types the kana again."
            },
            "candidatesLeft": {
              "type": "boolean",
              "description": "Reading and candidates in a panel left of the keys (fjk), instead of the top bar."
            },
            "flickHints": {
              "type": "boolean",
              "description": "Show each flick key's other kana small at its edges."
            },
            "romajiInput": {
              "type": "boolean",
              "description": "A JIS kana keyboard types romaji instead (its Latin legends through the keyboard's table); off: kana input."
            }
          }
        },
        "converter": {
          "enum": [
            "anthy"
          ],
          "description": "The engine that converts the reading (with composer kana): anthy, from the system's libanthy."
        },
        "table": {
          "$ref": "#/$defs/id",
          "description": "The table (kind table) for composer romaji."
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "colors"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "theme"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "colors": {
          "type": "object",
          "required": [
            "surface",
            "key",
            "keyText",
            "modifier",
            "accent"
          ],
          "additionalProperties": false,
          "properties": {
            "surface": {
              "$ref": "#/$defs/color"
            },
            "key": {
              "$ref": "#/$defs/color"
            },
            "keyText": {
              "$ref": "#/$defs/color"
            },
            "modifier": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color"
            },
            "legend": {
              "$ref": "#/$defs/color",
              "description": "Small Shift legends; default keyText."
            },
            "fnLegend": {
              "$ref": "#/$defs/color",
              "description": "Small Fn legends; default accent."
            },
            "hover": {
              "$ref": "#/$defs/color",
              "description": "Key under the laser; default a lighter key."
            }
          }
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "font": {
          "type": "string",
          "maxLength": 120
        },
        "followSteam": {
          "type": "boolean",
          "description": "Take colours from Steam's own keyboard theme at runtime."
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "flickKey": {
      "type": "object",
      "required": [
        "type",
        "flick"
      ],
      "additionalProperties": false,
      "description": "A 12-key flick key.",
      "properties": {
        "type": {
          "const": "flick"
        },
        "flick": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 4
          },
          "description": "What it types for [tap, flick left, up, right, down]; \"\" where a direction has nothing. The tap entry is required."
        },
        "cycle": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4
          },
          "description": "What tapping it again goes through when the keyboard's tapCycle option is on; default: its flick entries."
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "w": {
          "$ref": "#/$defs/width"
        },
        "hints": {
          "type": "boolean",
          "description": "Always show the other directions small at the key's edges, whatever the flick hints option says (e.g. a punctuation key)."
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "entries"
      ],
      "additionalProperties": false,
      "description": "A conversion table, e.g. romaji to kana.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "table"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4000,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "string",
              "maxLength": 16
            }
          },
          "description": "[input, output] or [input, output, letters left pending] (kk → っ, k waits)."
        }
      }
    }
  }
}
