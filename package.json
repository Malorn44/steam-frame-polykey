{
  "name": "polykey",
  "version": "0.0.0-development",
  "description": "Modular on-screen keyboard for the Valve Steam Frame, drawn inside Steam's own keyboard popup",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:ruff && npm run lint:ruff-format && npm run lint:shellcheck && npm run lint:actionlint",
    "lint:eslint": "tools/eslint/node_modules/.bin/eslint -c tools/eslint/eslint.config.js .",
    "lint:prettier": "prettier --check src tests scripts tools/eslint '*.{js,json,ts}'",
    "format": "prettier --write src tests scripts tools/eslint '*.{js,json,ts}'",
    "lint:ruff": ".venv/bin/ruff check sidecar scripts",
    "lint:ruff-format": ".venv/bin/ruff format --check sidecar scripts",
    "lint:shellcheck": ".venv/bin/shellcheck scripts/*.sh",
    "lint:actionlint": ".venv/bin/actionlint -shellcheck .venv/bin/shellcheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:py": ".venv/bin/python -m pytest sidecar/tests -q",
    "test:layout": "scripts/test-layout.sh",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:py && npm run build"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
